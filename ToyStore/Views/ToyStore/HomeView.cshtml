@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet"
          type="text/css"
          href="~/Content/MyContent/HomePage.css"/>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>
          
    <title></title>
</head>
<body>
    <header id="=headerhome" class="home-header">
        <h1 class="logo">
            <img class="anh-logo" src="~/Content/My image/98582e94c3e94c5c83ae526757ad003b.jpg" />
        </h1>
        <div class="search-section">
            <div class="search-container">
                <input type="text" id="search-input" placeholder="Nhập từ khóa..." />
                <button id="search-button"> Tìm kiếm </button>
            </div>
        </div>
        <ul class="icon-header">
            <li class="icon">
                <a href="#"><i class="fa-solid fa-user"></i></a>
            </li>
            <li class="icon">
                <a href="#"><i class="fa-solid fa-cart-shopping"></i></a>
            </li>
        </ul>
    </header>
    <nav class="main-menu">
        <ul>
            <li>
                <a href="#">
                    <img src="images/car.png" alt="Ô Tô">
                </a>
            </li>
            <li>
                <a href="#">
                    <img src="images/lego.png" alt="Xe Chuyên Dụng">
                </a>
            </li>
            <li>
                <a href="#">
                    <img src="images/motorcycle.png" alt="Mô Tô">
                </a>
            </li>
            <li>
                <a href="#">
                    <img src="images/motorcycle.png" alt="Gấu Bông">
                </a>
            </li>
        </ul>
    </nav>
    <section class="banner">
        <div class="banner-content">
        </div>
    </section>

    <nav class="feature-bar">

        <div class="feature-item">
            <div class="feature-icon">
                <i class="fa-solid fa-bag-shopping"></i>
            </div>

            <div class="feature-content">
                <h3>Sản Phẩm Đa Dạng</h3>
                <p>Luôn cập nhật những sản phẩm mới nhất</p>
            </div>
        </div>

        <div class="feature-item">
            <div class="feature-icon">
                <i class="fa-solid fa-truck-fast"></i>
            </div>

            <div class="feature-content">
                <h3>Giao Hàng Trong 1 Giờ</h3>
                <p>Giao hàng nhanh chóng và tiện lợi</p>
            </div>
        </div>

        <div class="feature-item">
            <div class="feature-icon">
                <i class="fa-solid fa-piggy-bank"></i>
            </div>

            <div class="feature-content">
                <h3>Tích Lũy Điểm Thưởng</h3>
                <p>Ưu đãi hấp dẫn dành cho khách hàng thân thiết</p>
            </div>
        </div>
    </nav>
    <section class="feature-product">
        <h2><i class="fa-solid fa-star"></i>Sản Phẩm Mới<i class="fa-solid fa-star"></i></h2>

        <div class="banner-product">
        </div>

        <div class="product-container">
            <div class="product-item">
                <img src="~/Content/My image/5702018068397.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/asdadada.jpg" alt="Sản Phẩm 2" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/wwwwewewe.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">399,000Đ</p>
            </div>
        </div>
    </section>

    <section class="feature-product-new">
        <h2><i class="fa-solid fa-star"></i>Giá Tốt Mỗi Ngày<i class="fa-solid fa-star"></i></h2>

        <div class="banner-product">
        </div>

        <div class="product-container">
            <div class="product-item">
                <img src="~/Content/My image/5702018068397.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/asdadada.jpg" alt="Sản Phẩm 2" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/wwwwewewe.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">399,000Đ</p>
            </div>
        </div>
    </section>

    <section class="feature-product-best">
        <h2><i class="fa-solid fa-star"></i>Sản Phẩm Bán Chạy<i class="fa-solid fa-star"></i></h2>

        <div class="banner-product">
        </div>

        <div class="product-container">
            <div class="product-item">
                <img src="~/Content/My image/5702018068397.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/asdadada.jpg" alt="Sản Phẩm 2" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">279,000Đ</p>
            </div>
            <div class="product-item">
                <img src="~/Content/My image/wwwwewewe.jpg" alt="Sản Phẩm 1" />
                <h3>Sản Phẩm 1</h3>
                <p class="price">399,000Đ</p>
            </div>
        </div>
    </section>
</body>
</html>
